@model IEnumerable<ENTPROG_XTIS3_Abo.Models.ProductsViewModel>

@{
    ViewData["Title"] = "Products";
}

<h2>Products</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i>
        Create new
    </a>
</p>
<table id="ProductsTable" class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Unit)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Qty)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateAdded)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateModified)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Unit)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Qty)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateAdded)
                </td>
                <td>
                    @if (item.DateModified != null)
                    {
                        <span>@item.DateModified?.ToString("MM/dd/yyyy hh:mm tt")</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProductID" class="btn btn-primary">
                        <i class="fas fa-edit"></i>
                        Edit
                    </a> |
                    <a asp-action="Delete" asp-route-id="@item.ProductID" class="btn btn-danger">
                        <i class="fas fa-trash"></i>
                        Delete
                    </a>
                </td>
            </tr>

        }
    </tbody>
</table>

@section Scripts {
    <script>
        let table = new DataTable('#ProductsTable');
    </script>
}
